{
  "name": "attio-plugins",
  "private": true,
  "description": "Attio plugins for Claude, Claude Code, ChatGPT and Codex",
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "generate": "node scripts/generate.ts",
    "check": "node scripts/generate.ts --check && prettier --check .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "build:openai-zip": "node scripts/build-openai-zip.ts",
    "validate:hosts": "node scripts/validate-hosts.ts",
    "typecheck": "tsc",
    "test": "node --test \"scripts/**/*.test.ts\""
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "ajv": "8.20.0",
    "fflate": "0.8.3",
    "prettier": "3.9.10",
    "typescript": "7.0.2",
    "yaml": "2.9.1",
    "zod": "4.6.7"
  }
}
